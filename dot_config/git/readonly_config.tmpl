[alias]
    a = "add"
    aa = "add --all"
    amend = "commit --amend --no-edit"
    c = "commit -a"
    ca = "commit -a -s"
    cam = "commit -a -s -m"
    cm = "commit -a -s -m"
    co = "checkout"
    cob = "checkout -b"
    com  = "!git switch $(git symbolic-ref --short refs/remotes/origin/HEAD | cut -d/ -f2-)"
    d = "diff"
    dc = "diff --cached"
    lg = "log --graph --abbrev-commit --decorate --format=format:'%C(blue)%h%C(reset) - %C(green)(%ar)%C(reset) %s %C(italic)- %an%C(reset)%C(magenta bold)%d%C(reset)' --all"
    pl = "pull"
    pu = "push"
    puf  = "push --force-with-lease"
    r = "reset HEAD"
    r1 = "reset HEAD^"
    r2 = "reset HEAD^^"
    rb = "rebase"
    rba = "rebase --abort"
    rbc = "rebase --continue"
    rbi = "rebase --interactive"
    rbs = "rebase --skip"
    rhard = "reset --hard"
    rhard1 = "reset HEAD^ --hard"
    rhard2 = "reset HEAD^^ --hard"
    rs = "restore --staged"
    s = "status"
    sd = "stash drop"
    spo = "stash pop"
    spu = "stash push"
    spua = "stash push --include-untracked"

{{ if lookPath "delta" }}
[core]
    pager = {{ output "which" "delta" | trim | quote }}
    excludesfile = "{{ .chezmoi.homeDir }}/.config/git/ignore"

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    features = side-by-side line-numbers decorations
{{ else }}
[core]
    excludesfile = "{{ .chezmoi.homeDir }}/.config/git/ignore"
{{ end }}

[init]
    defaultBranch = "main"

[pull]
    rebase = true

[user]
    email = {{ .githubemail | quote }}
    name = {{ .fullname | quote }}
    signingkey = BD0383B510975BA5

[includeIf "gitdir:~/Projects/NEOS/"]
    path = identity-work.inc

[includeIf "gitdir:~/Projects/Euclid/"]
    path = identity-work.inc

[includeIf "gitdir:~/Projects/IPAC/"]
    path = identity-work.inc

[includeIf "hasconfig:remote.*.url:git@vmipac-secure.ipac.caltech.edu:*/**"]
    path = identity-work.inc

[includeIf "hasconfig:remote.*.url:https://vmipac-secure.ipac.caltech.edu/**"]
    path = identity-work.inc

[includeIf "hasconfig:remote.*.url:git@git.neoscluster.ipac.caltech.edu:*/**"]
    path = identity-work.inc

[includeIf "hasconfig:remote.*.url:https://git.neoscluster.ipac.caltech.edu/**"]
    path = identity-work.inc

[push]
    autoSetupRemote = true
    followTags = true
    useForceIfIncludes = true

[fetch]
    prune = true
    all = true

[transfer]
    fsckObjects = true
    credentialsInUrl = die

[safe]
    bareRepository = explicit

[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
    missingCommitsCheck = error

[rerere]
    enabled = true
    autoUpdate = true

[merge]
    conflictstyle = diff3

[diff]
    algorithm = histogram
    colorMoved = default

[commit]
    gpgsign = true
    verbose = true

[branch]
    sort = -committerdate

[tag]
    gpgsign = true
    sort = version:refname

[column]
    ui = auto

[help]
    autocorrect = prompt

[gpg]
{{ if eq .chezmoi.os "darwin" }}
    program = {{ findExecutable "gpg2" (list "/bin" "/usr/bin" "/sbin" "/usr/sbin" "/usr/local/bin" "/usr/local/MacGPG2/bin" "/opt/homebrew/opt/coreutils/bin" "/opt/homebrew/opt/coreutils/bin" "/opt/homebrew/opt/coreutils/libexec/gnubin" "/opt/homebrew/opt/perl/bin" "/opt/homebrew/opt/ruby/bin" "/opt/homebrew/opt/binutils/bin" "/opt/homebrew/sbin") | quote }}
{{ else if eq .chezmoi.os "linux" }}
    program = {{ findExecutable "gpg2" (list "/bin" "/usr/bin" "/sbin" "/usr/sbin" "/usr/local/bin") | quote }}
{{ end }}

[lfs "https://vmipac-secure.ipac.caltech.edu/aehler/ansible-ipac-rhel9.git/info/lfs"]
    locksverify = true
